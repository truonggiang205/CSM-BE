# ==============================================================================
# CSM-BE - CẤU HÌNH MÔI TRƯỜNG CLOUD / PRODUCTION MẪU
# CẢNH BÁO BẢO MẬT:
# 1. TUYỆT ĐỐI KHÔNG dùng chung JWT_SECRET, INTERNAL_SECRET hay mật khẩu DB với local.
# 2. TUYỆT ĐỐI KHÔNG chạy lệnh `npm run seed -- --reset` với cấu hình cloud này.
# 3. KHÔNG commit file .env.cloud thật lên Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CHUNG
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=8000
AUTH_PORT=3001
PRODUCT_PORT=3002
INVENTORY_PORT=3003
ORDER_PORT=3004
PAYMENT_PORT=3005
NOTIFICATION_PORT=3006
DISCOUNT_PORT=3007
UPLOAD_DIR="/app/uploads"

# ------------------------------------------------------------------------------
# 2. CLOUD MYSQL (Yêu cầu SSL)
# ------------------------------------------------------------------------------
MYSQL_HOST="CHANGE_ME_CLOUD_MYSQL_HOST"
MYSQL_PORT=3306
MYSQL_USER="CHANGE_ME_CLOUD_MYSQL_USER"
MYSQL_PASSWORD="CHANGE_ME_CLOUD_MYSQL_PASSWORD"
MYSQL_ROOT_PASSWORD="CHANGE_ME_CLOUD_MYSQL_ROOT_PASSWORD"

AUTH_DB_URL="mysql://CHANGE_ME_CLOUD_MYSQL_USER:CHANGE_ME_CLOUD_MYSQL_PASSWORD@CHANGE_ME_CLOUD_MYSQL_HOST:3306/csm_auth?ssl-mode=REQUIRED"
PRODUCT_DB_URL="mysql://CHANGE_ME_CLOUD_MYSQL_USER:CHANGE_ME_CLOUD_MYSQL_PASSWORD@CHANGE_ME_CLOUD_MYSQL_HOST:3306/csm_product?ssl-mode=REQUIRED"
INVENTORY_DB_URL="mysql://CHANGE_ME_CLOUD_MYSQL_USER:CHANGE_ME_CLOUD_MYSQL_PASSWORD@CHANGE_ME_CLOUD_MYSQL_HOST:3306/csm_inventory?ssl-mode=REQUIRED"
ORDER_DB_URL="mysql://CHANGE_ME_CLOUD_MYSQL_USER:CHANGE_ME_CLOUD_MYSQL_PASSWORD@CHANGE_ME_CLOUD_MYSQL_HOST:3306/csm_order?ssl-mode=REQUIRED"
DISCOUNT_DB_URL="mysql://CHANGE_ME_CLOUD_MYSQL_USER:CHANGE_ME_CLOUD_MYSQL_PASSWORD@CHANGE_ME_CLOUD_MYSQL_HOST:3306/csm_discount?ssl-mode=REQUIRED"

# ------------------------------------------------------------------------------
# 3. JWT & BẢO MẬT NỘI BỘ (Bắt buộc >= 32 ký tự, khác hoàn toàn local)
# ------------------------------------------------------------------------------
JWT_SECRET="CHANGE_ME_PROD_JWT_SECRET_MIN_32_CHARS"
JWT_REFRESH_SECRET="CHANGE_ME_PROD_JWT_REFRESH_SECRET_MIN_32_CHARS"
INTERNAL_SECRET="CHANGE_ME_PROD_INTERNAL_SECRET_MIN_32_CHARS"

# ------------------------------------------------------------------------------
# 4. URL CÁC SERVICE & DOMAIN CÔNG KHAI
# ------------------------------------------------------------------------------
AUTH_SERVICE_URL="http://auth-service:3001"
PRODUCT_SERVICE_URL="http://product-service:3002"
INVENTORY_SERVICE_URL="http://inventory-service:3003"
ORDER_SERVICE_URL="http://order-service:3004"
PAYMENT_SERVICE_URL="http://payment-service:3005"
NOTIFICATION_SERVICE_URL="http://notification-service:3006"
DISCOUNT_SERVICE_URL="http://discount-service:3007"

PUBLIC_GATEWAY_URL="https://api.example.com"
API_GATEWAY_URL="https://api.example.com/api/v1"
FRONTEND_URL="https://app.example.com"

# ------------------------------------------------------------------------------
# 5. THANH TOÁN & CỜ AN TOÀN PRODUCTION
# ------------------------------------------------------------------------------
PAYMENT_SIMULATION="false"
PAYMENT_SIMULATION_SECRET="CHANGE_ME_PROD_PAYMENT_SIMULATION_SECRET_MIN_32_CHARS"

DB_SYNC="false"
ENABLE_SWAGGER="false"
ENABLE_TEST_DELAY="false"
