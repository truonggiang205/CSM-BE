# ==============================================================================
# CSM-BE - CẤU HÌNH MÔI TRƯỜNG MẪU (LOCAL / DEVELOPMENT)
# Sao chép thành .env (hoặc chạy: npm run env:init) trước khi khởi chạy hệ thống.
# KHÔNG commit file .env lên Git. KHÔNG dùng giá trị mẫu này cho production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CHUNG (General)
# ------------------------------------------------------------------------------
# Môi trường chạy: development | test | production (Bắt buộc)
NODE_ENV="development"

# Cổng lắng nghe của từng service (Không bắt buộc, có mặc định)
PORT=8000
AUTH_PORT=3001
PRODUCT_PORT=3002
INVENTORY_PORT=3003
ORDER_PORT=3004
PAYMENT_PORT=3005
NOTIFICATION_PORT=3006
DISCOUNT_PORT=3007

# Thư mục lưu trữ file upload ảnh sản phẩm (Không bắt buộc, mặc định: ./uploads)
UPLOAD_DIR="./uploads"

# ------------------------------------------------------------------------------
# 2. MYSQL & CHUỖI KẾT NỐI DATABASE
# ------------------------------------------------------------------------------
# Thông tin máy chủ MySQL dùng chung để lắp chuỗi kết nối trong Docker Compose
# (Bắt buộc khi chạy Docker Compose)
MYSQL_HOST="mysql"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="CHANGE_ME_MYSQL_PASSWORD_MIN_16_CHARS"
MYSQL_ROOT_PASSWORD="CHANGE_ME_MYSQL_ROOT_PASSWORD_MIN_16_CHARS"

# Chuỗi kết nối từng database (Bắt buộc với từng service tương ứng)
# Lưu ý: Khi chạy ngoài Docker (host), đổi host "mysql" thành "localhost".
AUTH_DB_URL="mysql://root:CHANGE_ME_MYSQL_PASSWORD_MIN_16_CHARS@localhost:3306/csm_auth"
PRODUCT_DB_URL="mysql://root:CHANGE_ME_MYSQL_PASSWORD_MIN_16_CHARS@localhost:3306/csm_product"
INVENTORY_DB_URL="mysql://root:CHANGE_ME_MYSQL_PASSWORD_MIN_16_CHARS@localhost:3306/csm_inventory"
ORDER_DB_URL="mysql://root:CHANGE_ME_MYSQL_PASSWORD_MIN_16_CHARS@localhost:3306/csm_order"
DISCOUNT_DB_URL="mysql://root:CHANGE_ME_MYSQL_PASSWORD_MIN_16_CHARS@localhost:3306/csm_discount"

# ------------------------------------------------------------------------------
# 3. JWT & BẢO MẬT NỘI BỘ (Bắt buộc, tối thiểu 32 ký tự)
# ------------------------------------------------------------------------------
# Khóa bí mật ký Access Token JWT (Bắt buộc, min 32 ký tự)
JWT_SECRET="CHANGE_ME_JWT_SECRET_MIN_32_CHARS_HEX_OR_RANDOM"

# Khóa bí mật ký Refresh Token JWT (Bắt buộc với auth-service, min 32 ký tự)
JWT_REFRESH_SECRET="CHANGE_ME_JWT_REFRESH_SECRET_MIN_32_CHARS_RANDOM"

# Khóa bí mật xác thực giao tiếp nội bộ giữa các microservice (Bắt buộc, min 32 ký tự)
INTERNAL_SECRET="CHANGE_ME_INTERNAL_SECRET_MIN_32_CHARS_RANDOM"

# ------------------------------------------------------------------------------
# 4. URL CÁC SERVICE
# ------------------------------------------------------------------------------
# URL nội bộ các microservice (Không bắt buộc khi chạy local, mặc định localhost)
AUTH_SERVICE_URL="http://localhost:3001"
PRODUCT_SERVICE_URL="http://localhost:3002"
INVENTORY_SERVICE_URL="http://localhost:3003"
ORDER_SERVICE_URL="http://localhost:3004"
PAYMENT_SERVICE_URL="http://localhost:3005"
NOTIFICATION_SERVICE_URL="http://localhost:3006"

# URL công khai của API Gateway và Frontend (Không bắt buộc, mặc định localhost)
PUBLIC_GATEWAY_URL="http://localhost:8000"
API_GATEWAY_URL="http://localhost:8000/api/v1"
FRONTEND_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 5. DISCOUNT SERVICE
# ------------------------------------------------------------------------------
# URL nội bộ của Discount Service (dùng bởi API Gateway và Order Service)
DISCOUNT_SERVICE_URL="http://localhost:3007"

# ------------------------------------------------------------------------------
# 6. THANH TOÁN MÔ PHỎNG (Payment Simulation)
# ------------------------------------------------------------------------------
# Khóa ký token cho luồng thanh toán mô phỏng (Bắt buộc khi PAYMENT_SIMULATION=true, min 32 ký tự)
PAYMENT_SIMULATION_SECRET="CHANGE_ME_PAYMENT_SIMULATION_SECRET_MIN_32_CHARS"

# ------------------------------------------------------------------------------
# 7. SEED / TEST
# ------------------------------------------------------------------------------
# Mật khẩu tài khoản demo khi chạy seed hoặc test E2E (Bắt buộc khi chạy seed/test)
SEED_PASSWORD="CHANGE_ME_SEED_PASSWORD_DEMO"

# Mật khẩu riêng cho từng vai trò (Không bắt buộc). Nếu bỏ trống/xóa dòng, tài khoản
# vai trò đó dùng SEED_PASSWORD. Giá trị dưới đây trùng bảng tài khoản trong README
# để demo local dễ nhớ. Sau khi đổi các giá trị này phải chạy lại: npm run seed
#   SEED_ADMIN_PASSWORD    -> admin@csm.vn
#   SEED_MANAGER_PASSWORD  -> manager.q1@csm.vn, manager.q2@csm.vn
#   SEED_CUSTOMER_PASSWORD -> customer@csm.vn, customer1@csm.vn, customer2@csm.vn
SEED_ADMIN_PASSWORD="Admin@123456"
SEED_MANAGER_PASSWORD="Manager@123456"
SEED_CUSTOMER_PASSWORD="Customer@123456"

# URL API Gateway dùng cho script test/benchmark (Không bắt buộc, mặc định http://localhost:8000/api/v1)
TEST_API_URL="http://localhost:8000/api/v1"

# Tự động dọn dữ liệu sau khi chạy test-e2e.js (Không bắt buộc, mặc định false)
TEST_CLEANUP="false"

# Database URL riêng cho E2E nếu muốn tách khỏi DB dev (Không bắt buộc)
# TEST_AUTH_DB_URL=""
# TEST_PRODUCT_DB_URL=""
# TEST_INVENTORY_DB_URL=""
# TEST_ORDER_DB_URL=""

# ------------------------------------------------------------------------------
# 8. CỜ NGUY HIỂM / CHỈ DÙNG CHO TEST (Mặc định an toàn: false)
# ------------------------------------------------------------------------------
# Tự động đồng bộ schema TypeORM (CHỈ bật true ở local dev lần đầu để tạo bảng; KHÔNG bật trên production)
DB_SYNC="false"

# Bật Swagger UI tại /docs (CHỈ bật true ở local dev/staging; tắt false trên production)
ENABLE_SWAGGER="false"

# Bật cổng thanh toán mô phỏng MoMo/VNPay (CHỈ bật true ở môi trường demo/test; tắt false trên production)
PAYMENT_SIMULATION="false"

# Giả lập độ trễ 5s trong discount-service để test Saga timeout (CHỈ bật true khi chạy test timeout)
ENABLE_TEST_DELAY="false"
