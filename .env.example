# Microservices Database URLs (MySQL with SSL required)
AUTH_DB_URL="mysql://username:password@hostname:port/csm_auth?ssl-mode=REQUIRED"
PRODUCT_DB_URL="mysql://username:password@hostname:port/csm_product?ssl-mode=REQUIRED"
INVENTORY_DB_URL="mysql://username:password@hostname:port/csm_inventory?ssl-mode=REQUIRED"
ORDER_DB_URL="mysql://username:password@hostname:port/csm_order?ssl-mode=REQUIRED"

# JWT & Internal Secret Keys
JWT_SECRET="your-jwt-access-secret-key-min-32-chars"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-min-32-chars"
INTERNAL_SECRET="your-secure-internal-communication-secret-key"

# Internal Microservices URLs for API Gateway
AUTH_SERVICE_URL="http://localhost:3001"
PRODUCT_SERVICE_URL="http://localhost:3002"
INVENTORY_SERVICE_URL="http://localhost:3003"
ORDER_SERVICE_URL="http://localhost:3004"
PAYMENT_SERVICE_URL="http://localhost:3005"
NOTIFICATION_SERVICE_URL="http://localhost:3006"

# Environment
NODE_ENV="development"
PORT=8000
